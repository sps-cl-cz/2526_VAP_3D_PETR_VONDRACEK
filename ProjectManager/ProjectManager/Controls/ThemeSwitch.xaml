<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectManager.Controls.ThemeSwitch"
             x:Name="Root">
    <VerticalStackLayout Padding="5" Spacing="5">
        <Label Text="Toggle Theme"
               FontSize="20"
               HorizontalOptions="Start" />
        <Switch IsToggled="{Binding IsDarkTheme, Source={x:Reference Root}, Mode=TwoWay}" HorizontalOptions="Start"/>
        <Label Text="{Binding CurrentTheme, Source={x:Reference Root}}"
               FontSize="16"
               HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentView>
